// Contact.kt
data class Contact(
    val lastName: String = "",
    val firstName: String = "",
    val middleName: String = "",
    val phone: String = ""
) {
    fun displayName(): String {
        val initials = listOf(firstName, middleName)
            .filter { it.isNotBlank() }
            .map { it.first().uppercaseChar() + "." }
            .joinToString(" ")
        return if (initials.isBlank()) lastName else "$lastName $initials"
    }
}


// ContactViewModel.kt
import androidx.lifecycle.LiveData
import androidx.lifecycle.MutableLiveData
import androidx.lifecycle.ViewModel

class ContactViewModel : ViewModel() {

    companion object {
        // Instance partagée entre les 3 activités
        val instance = ContactViewModel()
    }

    private val _contacts = MutableLiveData<MutableList<Contact>>(mutableListOf())
    val contacts: LiveData<MutableList<Contact>> = _contacts

    private val _currentIndex = MutableLiveData(0)
    val currentIndex: LiveData<Int> = _currentIndex

    fun current(): Contact? =
        _contacts.value?.getOrNull(_currentIndex.value ?: 0)

    fun next() {
        val list = _contacts.value ?: return
        if (list.isEmpty()) return
        _currentIndex.value = ((_currentIndex.value ?: 0) + 1) % list.size
    }

    fun previous() {
        val list = _contacts.value ?: return
        if (list.isEmpty()) return
        _currentIndex.value = ((_currentIndex.value ?: 0) - 1 + list.size) % list.size
    }

    fun add(contact: Contact) {
        val list = _contacts.value ?: mutableListOf()
        list.add(contact)
        _contacts.value = list
        _currentIndex.value = list.size - 1
    }

    fun update(contact: Contact) {
        val list = _contacts.value ?: return
        val idx = _currentIndex.value ?: return
        if (idx in list.indices) {
            list[idx] = contact
            _contacts.value = list
        }
    }
}


