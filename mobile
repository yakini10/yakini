//MainActivity
import android.content.Intent
import android.os.Bundle
import android.widget.Button
import android.widget.ImageView
import android.widget.TextView
import androidx.activity.result.contract.ActivityResultContracts
import androidx.appcompat.app.AppCompatActivity

class MainActivity : AppCompatActivity() {

    private val vm = ContactViewModel.instance
    private lateinit var tvContact: TextView

    // Un seul launcher pour les 2 activités (add + edit)
    private val launcher = registerForActivityResult(
        ActivityResultContracts.StartActivityForResult()
    ) { refresh() }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        tvContact = findViewById(R.id.tvContact)

        findViewById<ImageView>(R.id.btnPrev).setOnClickListener {
            vm.previous(); refresh()
        }
        findViewById<ImageView>(R.id.btnNext).setOnClickListener {
            vm.next(); refresh()
        }

        // Bouton "Добавить" → AddActivity
        findViewById<Button>(R.id.btnAdd).setOnClickListener {
            launcher.launch(Intent(this, AddActivity::class.java))
        }

        // Bouton "Изменить" → EditActivity
        findViewById<Button>(R.id.btnEdit).setOnClickListener {
            if (vm.current() == null) return@setOnClickListener
            launcher.launch(Intent(this, EditActivity::class.java))
        }

        refresh()
    }

    private fun refresh() {
        val c = vm.current()
        tvContact.text = c?.displayName() ?: "Нет данных"
    }
}


//AddActivity
import android.os.Bundle
import android.widget.Button
import android.widget.EditText
import androidx.appcompat.app.AppCompatActivity

class AddActivity : AppCompatActivity() {

    private val vm = ContactViewModel.instance

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_add)

        val etLast = findViewById<EditText>(R.id.etLastName)
        val etFirst = findViewById<EditText>(R.id.etFirstName)
        val etMiddle = findViewById<EditText>(R.id.etMiddleName)
        val etPhone = findViewById<EditText>(R.id.etPhone)

        findViewById<Button>(R.id.btnSave).setOnClickListener {
            val contact = Contact(
                lastName = etLast.text.toString().trim(),
                firstName = etFirst.text.toString().trim(),
                middleName = etMiddle.text.toString().trim(),
                phone = etPhone.text.toString().trim()
            )
            if (contact.lastName.isBlank() && contact.firstName.isBlank()) {
                // validation minimale
                etLast.error = "Введите фамилию"
                return@setOnClickListener
            }
            vm.add(contact)
            finish() // retour à MainActivity
        }
    }
}


//EditActivity
import android.os.Bundle
import android.widget.Button
import android.widget.EditText
import androidx.appcompat.app.AppCompatActivity

class EditActivity : AppCompatActivity() {

    private val vm = ContactViewModel.instance

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_edit)

        val etLast = findViewById<EditText>(R.id.etLastName)
        val etFirst = findViewById<EditText>(R.id.etFirstName)
        val etMiddle = findViewById<EditText>(R.id.etMiddleName)
        val etPhone = findViewById<EditText>(R.id.etPhone)

        // Pré-remplir avec le contact courant
        vm.current()?.let { c ->
            etLast.setText(c.lastName)
            etFirst.setText(c.firstName)
            etMiddle.setText(c.middleName)
            etPhone.setText(c.phone)
        }

        findViewById<Button>(R.id.btnSave).setOnClickListener {
            val contact = Contact(
                lastName = etLast.text.toString().trim(),
                firstName = etFirst.text.toString().trim(),
                middleName = etMiddle.text.toString().trim(),
                phone = etPhone.text.toString().trim()
            )
            vm.update(contact)
            finish() // retour à MainActivity
        }
    }
}



 //AndroidManifest.xml
